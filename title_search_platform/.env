# MinIO Configuration
# MINIO_ENDPOINT should be http://minio:9000 when running 'api' service inside docker-compose
# MINIO_ENDPOINT should be http://localhost:9000 when running Python app directly on host for development
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=title-search-bucket

# MySQL Database Configuration
# MYSQL_HOST should be 'db' when running 'api' service inside docker-compose
# MYSQL_HOST should be 'localhost' when running Python app directly on host for development
MYSQL_HOST=db
MYSQL_DATABASE=file_metadata_db
MYSQL_USER=user_db
MYSQL_PASSWORD=password_db
MYSQL_ROOT_PASSWORD=root_password_db # Used by docker-compose to initialize the MySQL service
MYSQL_PORT=3306

# Application settings
# DEBUG=True
# SECRET_KEY=your_very_secret_ fastapi_key

# Note: The actual values provided here are examples.
# Users should change them for production environments, especially secrets.
MINIO_PUBLIC_HOST=minio
